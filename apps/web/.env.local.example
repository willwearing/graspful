# Copy to apps/web/.env.local. Use an isolated local Supabase project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_PLATFORM_HOST=graspful.ai
NEXT_PUBLIC_APP_HOST=app.graspful.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional server-only backend endpoint and local brand preview
# BACKEND_INTERNAL_URL=http://localhost:3000/api/v1
# DEV_BRAND_ID=graspful

# Optional analytics, errors, and logs. Empty keys disable collection.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Optional source map upload credentials. Never prefix secrets with NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Supplied by the runtime or deployment system; leave unset locally.
# NODE_ENV=development
# NEXT_RUNTIME=nodejs
# VERCEL_GIT_COMMIT_SHA=commit-sha
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=commit-sha
# NEXT_PUBLIC_VERCEL_ENV=development
# Playwright requires explicit local environment variables, see docs/local-e2e.md.
