# Copy to backend/.env. Use keys from an isolated local Supabase project.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Prisma migrations use a direct connection; hosted deployments may use a pooler
# for DATABASE_URL and a separate direct connection for DIRECT_URL.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
APP_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Optional audio generation. Leave URL unset when the service is unavailable.
# KOKORO_TTS_URL=https://your-modal-app--kokoro-tts-speech.modal.run
MODAL_AUTH_KEY=
MODAL_AUTH_SECRET=

# Optional analytics, errors, and logs. Empty key disables collection.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional Stripe integration. See docs/billing-setup.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# Optional automated domain provisioning. Server-only credentials.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_API_TOKEN=

# Maintenance script file-path override
# INVOCATION_CWD=/absolute/path/to/course/files
# Migration tests require explicit local database credentials.
# MIGRATION_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
