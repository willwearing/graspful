# Environment reference for the whole repository. Copy only the relevant values
# to backend/.env, apps/web/.env.local, or apps/site/.env.local. Root .env is not
# automatically loaded by every workspace. Never commit populated credentials.

# Backend and local database (use an isolated Supabase project)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
APP_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Public browser configuration (these values are embedded in Next.js builds)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_PLATFORM_HOST=graspful.ai
NEXT_PUBLIC_APP_HOST=app.graspful.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional private backend URL used by server-side brand resolution
# BACKEND_INTERNAL_URL=http://localhost:3000/api/v1
# DEV_BRAND_ID=graspful

# Optional PostHog analytics, errors, and logs. Empty keys disable collection.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Optional server-only credentials for production source map uploads
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Optional billing configuration. Configure all prices and webhooks before use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# Optional audio generation. Keep URL unset until a valid service is available.
# KOKORO_TTS_URL=https://your-modal-app--kokoro-tts-speech.modal.run
MODAL_AUTH_KEY=
MODAL_AUTH_SECRET=

# Optional automated Vercel domain provisioning, server-only credentials
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_API_TOKEN=

# CLI and MCP. Saved credentials in ~/.graspful/credentials.json are supported.
GRASPFUL_API_URL=http://localhost:3000
GRASPFUL_API_KEY=
GRASPFUL_USER_ID=
# GRASPFUL_CONFIG_DIR=/absolute/path/to/isolated/credentials
GRASPFUL_TELEMETRY_DISABLED=1

# Test controls. Export local credentials explicitly; see docs/local-e2e.md.
# E2E_REUSE_EXISTING_SERVER=1
# MIGRATION_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# CI=true

# Maintenance script override for resolving relative course file paths
# INVOCATION_CWD=/absolute/path/to/course/files
# k6 load-test.js reads these with --env, rather than loading this file.
# API_URL=http://localhost:3000
# AUTH_TOKEN=local-test-user-jwt
# ORG_ID=local-test-org-id
# COURSE_ID=local-test-course-id

# Set by the hosting/build runtime. Usually leave these unset locally.
# NEXT_RUNTIME=nodejs
# VERCEL_GIT_COMMIT_SHA=commit-sha
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=commit-sha
# NEXT_PUBLIC_VERCEL_ENV=development
